        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam ArrowColor #A85B74\nskinparam actorStyle stickman\nskinparam linetype polyline\n\nskinparam usecase {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  FontColor #222222\n}\n\nactor \&quot;Người xử lý\\nhồ sơ\&quot; as XL\n\nrectangle \&quot;PHÂN RÃ USE CASE - TIẾP NHẬN VÀ THẨM ĐỊNH\&quot; {\n\n  usecase \&quot;UC07\\nTiếp nhận hồ sơ\&quot; as UC07\n\n  usecase \&quot;UC08\\nKiểm tra tính hợp lệ\\nhồ sơ\&quot; as UC08\n\n  usecase \&quot;UC09\\nThẩm định hồ sơ\&quot; as UC09\n\n  usecase \&quot;UC10\\nKiểm tra địa điểm\&quot; as UC10\n\n  usecase \&quot;UC11\\nKiểm tra phương án\\nan toàn\&quot; as UC11\n\n  usecase \&quot;UC12\\nKiểm tra điều kiện\\ncấp phép\&quot; as UC12\n}\n\nXL -- UC07\nXL -- UC08\nXL -- UC09\n\nUC09 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC09 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC09 ..&gt; UC12 : &lt;&lt;include&gt;&gt;\n\nnote right of UC08\n  Hồ sơ đầy đủ, hợp lệ:\n  Chuyển sang thẩm định.\n\n  Hồ sơ thiếu hoặc sai:\n  Chuyển Yêu cầu bổ sung.\n\n  UC06 do Người tổ chức thực hiện sau đó.\nend note\n\nnote right of UC09\n  Bắt buộc thực hiện:\n  UC10 - Kiểm tra địa điểm\n  UC11 - Kiểm tra phương án an toàn\n  UC12 - Kiểm tra điều kiện cấp phép\n\n  Lưu kết quả và phiên bản quy tắc.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="g0oCaI_5Rve2QDrYmSqa-45">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
