        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  DiamondBackgroundColor #FFF0C5\n}\n\nstart\n\n:Người tổ chức mở FrmChonDiaDiem;\n:Nhập tên hoặc khu vực;\n:Chọn ngày giờ tổ chức dự kiến;\n:Nhập quy mô người tham dự;\n\nif (Bộ lọc hợp lệ?) then (Có)\n\n  :Tra cứu DIA_DIEM đang hoạt động;\n  :Lọc theo sức chứa;\n  :Đối chiếu lịch tham khảo;\n  :Hiển thị danh sách phù hợp;\n\n  if (Người tổ chức chọn địa điểm?) then (Có)\n\n    :Xem thông tin chi tiết;\n    :Kiểm tra quyền sở hữu hồ sơ;\n    :Kiểm tra trạng thái NHAP;\n\n    if (Địa điểm và hồ sơ hợp lệ?) then (Có)\n\n      :Gán MaDiaDiem cho hồ sơ;\n      :Lưu thay đổi vào HO_SO_CAP_PHEP;\n      :Trả kết quả về FrmHoSo;\n      :Thông báo chọn thành công;\n\n    else (Không)\n\n      :Thông báo không thể chọn địa điểm;\n\n    endif\n\n  else (Không)\n\n    :Quay lại hồ sơ Nháp;\n\n  endif\n\nelse (Không)\n\n  :Thông báo bộ lọc không hợp lệ;\n\nendif\n\nnote right\n  UC28 không giữ chỗ.\n  UC04 phải kiểm tra lại\n  sức chứa và lịch trước khi nộp.\nend note\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n8Gjqb5mg1hr0XabP9dd-134">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;shadow=0;fontFamily=Times New Roman;" plantUmlBaseValue="" id="n8Gjqb5mg1hr0XabP9dd-135">
