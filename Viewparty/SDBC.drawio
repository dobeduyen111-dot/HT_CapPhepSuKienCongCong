        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  DiamondBackgroundColor #FFF0C5\n}\n\nstart\n\n:Người tổ chức chọn Tạo hồ sơ;\n:Hệ thống tạo hồ sơ NHAP;\n:Nhập thông tin sự kiện;\n:Nhập thời gian và quy mô;\n:Khai báo phương án vé/QR;\n:Khai báo quyền trình chiếu;\n:Nhập phương án an toàn;\n:Tải tài liệu đính kèm;\n\nif (Muốn chọn địa điểm?) then (Có)\n\n  :Mở UC28;\n  :Tra cứu danh sách địa điểm;\n\n  if (Chọn địa điểm hợp lệ?) then (Có)\n    :Gán MaDiaDiem vào hồ sơ Nháp;\n  else (Không)\n    :Tiếp tục hoàn thiện hồ sơ;\n  endif\n\nelse (Không)\n  :Chưa chọn địa điểm;\nendif\n\n:Chọn Lưu Nháp;\n:Kiểm tra cấu trúc dữ liệu;\n\nif (Dữ liệu hợp lệ để lưu Nháp?) then (Có)\n  :Lưu HO_SO_CAP_PHEP;\n  :Giữ trạng thái NHAP;\n  :Thông báo lưu thành công;\nelse (Không)\n  :Thông báo nội dung cần chỉnh sửa;\nendif\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n8Gjqb5mg1hr0XabP9dd-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
