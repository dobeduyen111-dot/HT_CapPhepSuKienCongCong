        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam activityBackgroundColor #FFF8DC\nskinparam activityBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nstart\n\n:Kiểm tra phản hồi liên ngành;\n\nif (Đã đủ ý kiến bắt buộc?) then (Có)\n\n  :Lấy kết quả thẩm định;\n  :Lấy ý kiến liên ngành;\n  :Tổng hợp toàn bộ kết quả;\n\n  if (Có điều kiện Bắt buộc Không đạt?) then (Có)\n\n    if (Có điều kiện Không đạt\\nkhông cho phép ngoại lệ?) then (Có)\n      :Kết luận Không đủ điều kiện;\n    else (Không)\n      :Cho phép thực hiện UC27\\nĐề xuất ngoại lệ;\n    endif\n\n  else (Không)\n    :Cập nhật trạng thái Chờ phê duyệt;\n  endif\n\nelse (Không)\n  :Chặn tổng hợp;\n  :Thông báo còn thiếu ý kiến liên ngành;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_KCB3ZGdKL114tAghsOc-423">
