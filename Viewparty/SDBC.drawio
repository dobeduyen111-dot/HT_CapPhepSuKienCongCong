        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HINH 2.7 - BIEU DO LOP PHAN TICH HE THONG VIEW PARTY\n\nleft to right direction\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 35\nskinparam ranksep 45\n\nskinparam class {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  ArrowColor #A85B74\n  FontColor #222222\n}\n\nhide circle\nhide methods\n\nclass \&quot;TaiKhoan\&quot; as TK {\n  maTaiKhoan\n  tenDangNhap\n  hoTen\n  email\n  vaiTro\n  capThamQuyen\n  trangThai\n}\n\nclass \&quot;DonViLienNganh\&quot; as DV {\n  maDonVi\n  tenDonVi\n  linhVuc\n  trangThai\n}\n\nclass \&quot;LoaiSuKien\&quot; as LOAI {\n  maLoaiSuKien\n  tenLoai\n  moTa\n  trangThai\n}\n\nclass \&quot;DiaDiem\&quot; as DD {\n  maDiaDiem\n  tenDiaDiem\n  diaChi\n  sucChua\n  trangThai\n}\n\nclass \&quot;HoSoCapPhep\&quot; as HS {\n  maHoSo\n  nguoiToChucId\n  nguoiXuLyHienTaiId\n  maLoaiSuKien\n  maDiaDiem\n  ngayTao\n  ngayNop\n  trangThai\n  --\n  tenSuKien\n  batDau\n  ketThuc\n  quyMo\n  noiDung\n  --\n  hinhThucThuongMai\n  coTaiTro\n  thongTinTaiTro\n  --\n  loaiVe\n  giaVe\n  soLuongVe\n  kenhPhatHanhVe\n  cachKiemSoatVe\n  --\n  nhanSuYTe\n  nhanSuAnNinh\n  phuongAnThoatHiem\n  phuongAnXuLySuCo\n}\n\nclass \&quot;QuyenTrinhChieu\&quot; as QTC {\n  maQuyen\n  maHoSo\n  donViCap\n  soVanBan\n  loaiQuyen\n  noiDungDuocCap\n  phamViDiaDiem\n  hieuLucTu\n  hieuLucDen\n  tepDinhKem\n}\n\nclass \&quot;TaiLieu\&quot; as TL {\n  maTaiLieu\n  maHoSo\n  loaiTaiLieu\n  tenTaiLieu\n  duongDan\n  ngayTaiLen\n}\n\nclass \&quot;QuyTac\&quot; as QT {\n  quyTacId\n  maQuyTac\n  phienBan\n  maLoaiSuKien\n  nhom\n  mucDo\n  dieuKienApDung\n  dieuKienDat\n  choPhepNgoaiLe\n  capThamQuyen\n  hieuLucTu\n  hieuLucDen\n}\n\nclass \&quot;CauHinhLienNganh\&quot; as CH {\n  maCauHinh\n  maLoaiSuKien\n  maDonVi\n  quyTacId\n  batBuoc\n  soNgayPhanHoi\n  hieuLucTu\n  hieuLucDen\n}\n\nclass \&quot;KetQuaKiemTra\&quot; as KQ {\n  maKetQua\n  maHoSo\n  quyTacId\n  nguoiKiemTraId\n  ketQua\n  giaTriThucTe\n  ghiChu\n  ngayDanhGia\n}\n\nclass \&quot;YeuCauYKien\&quot; as YC {\n  maYeuCau\n  maHoSo\n  maDonVi\n  maCauHinh\n  nguoiGuiId\n  nguoiPhanHoiId\n  ngayGui\n  hanPhanHoi\n  trangThai\n  ketLuan\n  noiDungPhanHoi\n  ngayPhanHoi\n}\n\nclass \&quot;NgoaiLe\&quot; as NL {\n  maNgoaiLe\n  maHoSo\n  maKetQua\n  nguoiDeXuatId\n  nguoiPheDuyetId\n  lyDo\n  minhChung\n  bienPhapBuDap\n  trangThai\n}\n\nclass \&quot;GiayPhep\&quot; as GP {\n  maGiayPhep\n  maHoSo\n  nguoiPheDuyetId\n  soGiayPhep\n  ngayCap\n  hieuLucTu\n  hieuLucDen\n}\n\nclass \&quot;LichSuXuLy\&quot; as LS {\n  maLichSu\n  maHoSo\n  maTaiKhoan\n  hanhDong\n  tuTrangThai\n  denTrangThai\n  thoiDiem\n}\n\nclass \&quot;NhatKyCauHinh\&quot; as NK {\n  maNhatKy\n  maTaiKhoan\n  doiTuong\n  hanhDong\n  giaTriTruoc\n  giaTriSau\n  thoiDiem\n}\n\nclass \&quot;ThongBao\&quot; as TB {\n  maThongBao\n  nguoiNhanId\n  maHoSo\n  loaiThongBao\n  noiDung\n  trangThai\n  thoiDiemTao\n}\n\n&#39; QUAN LY NGUOI DUNG\n\nDV \&quot;0..1\&quot; -- \&quot;0..*\&quot; TK : thuộc đơn vị\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; HS : người tổ chức\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; HS : người xử lý\n\n&#39; HO SO VA DIA DIEM\n\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; HS : loại sự kiện\nDD \&quot;0..1\&quot; -- \&quot;0..*\&quot; HS : địa điểm chọn\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; QTC : quyền trình chiếu\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; TL : tài liệu\n\n&#39; QUY TAC VA CAU HINH\n\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; QT : quy tắc\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; CH : cấu hình liên ngành\nDV \&quot;1\&quot; -- \&quot;0..*\&quot; CH : đơn vị được cấu hình\nQT \&quot;0..1\&quot; -- \&quot;0..*\&quot; CH : điều kiện áp dụng\n\n&#39; THAM DINH\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; KQ : kết quả kiểm tra\nQT \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : phiên bản quy tắc\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : người kiểm tra\n\n&#39; Y KIEN LIEN NGANH\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; YC : yêu cầu ý kiến\nDV \&quot;1\&quot; -- \&quot;0..*\&quot; YC : đơn vị phản hồi\nCH \&quot;1\&quot; -- \&quot;0..*\&quot; YC : cấu hình áp dụng\n\n&#39; NGOAI LE\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; NL : đề xuất ngoại lệ\nKQ \&quot;1\&quot; -- \&quot;0..1\&quot; NL : căn cứ ngoại lệ\n\n&#39; CAP GIAY PHEP\n\nHS \&quot;1\&quot; -- \&quot;0..1\&quot; GP : giấy phép\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; GP : người phê duyệt\n\n&#39; LICH SU VA THONG BAO\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; LS : lịch sử xử lý\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; LS : người thao tác\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; NK : thay đổi cấu hình\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; TB : người nhận\nHS \&quot;0..1\&quot; -- \&quot;0..*\&quot; TB : hồ sơ liên quan\n\nnote right of DD\n  UC28:\n  Tra cứu và lựa chọn địa điểm.\n\n  Một hồ sơ Nháp có thể\n  chưa có địa điểm.\n\n  Chọn địa điểm không giữ chỗ.\nend note\n\nnote bottom of HS\n  Đã tích hợp:\n  - Thông tin sự kiện\n  - Phương án vé và QR\n  - Phương án an toàn\n\n  UC04 kiểm tra lại điều kiện\n  địa điểm trước khi nộp.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pU3rxNRsT_0Tz161HMCt-91">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
