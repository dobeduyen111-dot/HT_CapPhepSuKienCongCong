        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam activityBackgroundColor #FFF8DC\nskinparam activityBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nstart\n\n:Mở hồ sơ Yêu cầu bổ sung;\n:Xem nội dung cần bổ sung;\n:Cập nhật thông tin/tài liệu;\n:Chọn Nộp lại;\n\nif (Nội dung bổ sung đầy đủ?) then (Có)\n\n  if (Có thay đổi địa điểm/thời gian?) then (Có)\n    :Kiểm tra lại sức chứa;\n    :Kiểm tra lại trùng lịch;\n\n    if (Điều kiện tiếp nhận vẫn đạt?) then (Có)\n      :Cập nhật trạng thái Đã nộp;\n      :Ghi lịch sử bổ sung;\n    else (Không)\n      :Thông báo cần chỉnh sửa;\n    endif\n\n  else (Không)\n    :Cập nhật trạng thái Đã nộp;\n    :Ghi lịch sử bổ sung;\n  endif\n\nelse (Không)\n  :Thông báo nội dung còn thiếu;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_KCB3ZGdKL114tAghsOc-186">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
