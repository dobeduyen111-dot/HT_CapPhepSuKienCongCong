        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam ArrowColor #A85B74\nskinparam actorStyle stickman\nskinparam linetype polyline\n\nskinparam usecase {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  FontColor #222222\n}\n\nactor \&quot;Người xử lý\\nhồ sơ\&quot; as XL\nactor \&quot;Đơn vị\\nliên ngành\&quot; as LN\nactor \&quot;Người\\nphê duyệt\&quot; as PD\n\nrectangle \&quot;PHÂN RÃ USE CASE - LIÊN NGÀNH VÀ NGOẠI LỆ\&quot; {\n\n  usecase \&quot;UC13\\nXin ý kiến liên ngành\&quot; as UC13\n\n  usecase \&quot;UC14\\nGửi ý kiến liên ngành\&quot; as UC14\n\n  usecase \&quot;UC15\\nTổng hợp kết quả\\nthẩm định\&quot; as UC15\n\n  usecase \&quot;UC27\\nĐề xuất ngoại lệ\&quot; as UC27\n\n  usecase \&quot;UC18\\nPhê duyệt hoặc\\ntừ chối ngoại lệ\&quot; as UC18\n}\n\nXL -- UC13\nXL -- UC15\nXL -- UC27\n\nLN -- UC14\n\nPD -- UC18\n\nUC27 ..&gt; UC15 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC15\n  Tiền điều kiện:\n  Đã nhận đủ ý kiến liên ngành bắt buộc.\n\n  Điểm mở rộng: Đề xuất ngoại lệ.\n\n  Điều kiện:\n  - Có điều kiện bắt buộc không đạt\n  - Quy tắc cho phép ngoại lệ\n  - Người xử lý chọn lập đề xuất\n    ngay trong bước tổng hợp\nend note\n\nnote right of UC18\n  Chỉ được xét khi có đề xuất hợp lệ.\n\n  Người phê duyệt phải:\n  - Đủ thẩm quyền\n  - Khác người đề xuất\n\n  Quyết định ngoại lệ được lưu riêng.\n  Không sửa kết quả kiểm tra ban đầu.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7vILHQm5s8omMgMBvrmK-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
