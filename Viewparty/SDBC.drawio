        <UserObject label="Kiểm tra lịch phải được đồng bộ&#xa;giữa các giao dịch nộp đồng thời.&#xa;Không dựa vào kết quả UC28 cũ." plantUmlId="note_48" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontColor=#000000;fontSize=13;align=left;spacingLeft=4;spacing=2;verticalAlign=middle;whiteSpace=wrap;html=1;shadow=0;fontFamily=Times New Roman;" plantUmlBaseValue="Kiểm tra lịch phải được đồng bộ&#xa;giữa các giao dịch nộp đồng thời.&#xa;Không dựa vào kết quả UC28 cũ." id="lx9Sh0RKUkfK1Wfze3iJ-217">
          <mxCell parent="lx9Sh0RKUkfK1Wfze3iJ-158" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontColor=#000000;fontSize=13;align=left;spacingLeft=4;spacing=2;verticalAlign=middle;whiteSpace=wrap;html=1;shadow=0;fontFamily=Times New Roman;" vertex="1">
            <mxGeometry height="55" width="313.73029999999994" x="641.9622785714287" y="21253.4" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam sequence {\n  ParticipantBackgroundColor #FFF8DC\n  ParticipantBorderColor #A85B74\n  ArrowColor #A85B74\n}\n\nactor \&quot;Người tổ chức\&quot; as NTC\nboundary \&quot;FrmChonDiaDiem\&quot; as UI\ncontrol \&quot;DiaDiemService\&quot; as DS\nentity \&quot;DiaDiemRepository\&quot; as DR\ncontrol \&quot;HoSoService\&quot; as HS\nentity \&quot;HoSoRepository\&quot; as HR\ndatabase \&quot;SQL Server\&quot; as DB\n\nNTC -&gt; UI : Mở tra cứu địa điểm\nNTC -&gt; UI : Nhập từ khóa, quy mô, thời gian\n\nUI -&gt; DS : TraCuu(dieuKien)\nDS -&gt; DS : Kiểm tra bộ lọc\n\nalt Bộ lọc không hợp lệ\n  DS --&gt; UI : Thông báo lỗi\nelse Hợp lệ\n  DS -&gt; DR : TimDiaDiemPhuHop()\n  DR -&gt; DB : SELECT DIA_DIEM\n  DR -&gt; DB : Đối chiếu lịch tham khảo\n  DB --&gt; DR : Danh sách và cảnh báo\n  DR --&gt; DS : Kết quả\n  DS --&gt; UI : Hiển thị danh sách\n\n  opt Xem chi tiết địa điểm\n    NTC -&gt; UI : Chọn Xem chi tiết\n    UI -&gt; DS : LayChiTiet(maDiaDiem)\n    DS -&gt; DR : TimTheoMa(maDiaDiem)\n    DR -&gt; DB : SELECT DIA_DIEM\n    DB --&gt; DR : Thông tin\n    DR --&gt; DS : Chi tiết\n    DS --&gt; UI : Hiển thị chi tiết\n  end\n\n  opt Chọn địa điểm cho hồ sơ Nháp\n    NTC -&gt; UI : Xác nhận lựa chọn\n    UI -&gt; HS : ChonDiaDiem(maHoSo, maDiaDiem)\n\n    HS -&gt; HS : Kiểm tra quyền sở hữu\n    HS -&gt; HS : Kiểm tra trạng thái NHAP\n    HS -&gt; DS : KiemTraDiaDiemHoatDong()\n    DS -&gt; DR : LayChiTiet(maDiaDiem)\n    DR -&gt; DB : SELECT DIA_DIEM\n    DB --&gt; DR : Địa điểm hiện tại\n    DR --&gt; DS : Thông tin\n    DS --&gt; HS : Kết quả\n\n    alt Được phép chọn\n      HS -&gt; HR : GanDiaDiemChoNhap()\n      HR -&gt; DB : UPDATE HO_SO_CAP_PHEP\n      DB --&gt; HR : Thành công\n      HR --&gt; HS : Đã cập nhật\n      HS --&gt; UI : Chọn thành công\n    else Không hợp lệ\n      HS --&gt; UI : Từ chối chọn địa điểm\n    end\n  end\nend\n\nUI --&gt; NTC : Hiển thị kết quả\n\nnote over DS,DB\n  Chỉ tra cứu và lưu lựa chọn.\n  UC28 không giữ chỗ.\n  UC04 kiểm tra lại khi nộp.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lx9Sh0RKUkfK1Wfze3iJ-218">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
