        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 18\nskinparam participantBackgroundColor #FFF8DC\nskinparam participantBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nactor \&quot;Người xử lý hồ sơ\&quot; as A\nboundary \&quot;FrmDeXuatNgoaiLe\&quot; as F\ncontrol \&quot;NgoaiLeService\&quot; as S\ncontrol \&quot;ThongBaoService\&quot; as TB\ndatabase \&quot;KetQuaRepository\&quot; as K\ndatabase \&quot;QuyTacRepository\&quot; as Q\ndatabase \&quot;YeuCauYKienRepository\&quot; as Y\ndatabase \&quot;NgoaiLeRepository\&quot; as N\ndatabase \&quot;NguoiPheDuyetRepository\&quot; as P\n\nA -&gt; F : Chọn điều kiện Bắt buộc Không đạt\nF -&gt; S : kiemTraKhaNangNgoaiLe(maKetQua)\n\nS -&gt; K : layKetQua(maKetQua)\nK --&gt; S : kết quả + quy tắc\n\nS -&gt; Q : layQuyTac(...)\nQ --&gt; S : choPhepNgoaiLe + cấp thẩm quyền\n\nS -&gt; Y : kiemTraDayDuYKien(maHoSo)\nY --&gt; S : đủ / thiếu\n\nalt Không cho phép ngoại lệ\n    S --&gt; F : Không được đề xuất\nelse Chưa đủ ý kiến liên ngành\n    S --&gt; F : Chưa được đề xuất\nelse Đủ điều kiện\n    S --&gt; F : Cho phép nhập đề xuất\n\n    A -&gt; F : Nhập lý do, minh chứng,\\nbiện pháp bù đắp\n    A -&gt; F : Chọn Lập đề xuất\n\n    F -&gt; S : taoNgoaiLe(...)\n\n    S -&gt; P : timNguoiDuThamQuyen(cap)\n    P --&gt; S : người phê duyệt\n\n    S -&gt; N : lưu Ngoại lệ = Chờ duyệt\n    S -&gt; TB : thông báo người phê duyệt\n\n    S --&gt; F : tạo đề xuất thành công\nend\n\nF --&gt; A : Hiển thị kết quả\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LKEJ2Bqn9yLJKuePsXGK-990">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=15;" vertex="1">
