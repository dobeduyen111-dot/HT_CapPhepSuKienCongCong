        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam activityBackgroundColor #FFF8DC\nskinparam activityBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nstart\n\n:Mở Quản lý tài khoản;\n:Chọn tài khoản hoặc tạo mới;\n\nif (Tạo tài khoản mới?) then (Có)\n  :Nhập thông tin tài khoản;\nelse (Không)\n\n  if (Chỉnh sửa thông tin?) then (Có)\n    :Cập nhật thông tin;\n  else (Không)\n\n    if (Khóa/Mở khóa?) then (Có)\n      :Thay đổi trạng thái tài khoản;\n    else (Không)\n      :Gán/Cập nhật vai trò;\n    endif\n\n  endif\nendif\n\nif (Dữ liệu và quyền hợp lệ?) then (Có)\n  :Lưu thay đổi;\n  :Ghi nhật ký cấu hình;\nelse (Không)\n  :Thông báo lỗi;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_KCB3ZGdKL114tAghsOc-584">
