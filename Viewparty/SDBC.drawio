        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 18\nskinparam participantBackgroundColor #FFF8DC\nskinparam participantBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nactor \&quot;Người xử lý hồ sơ\&quot; as A\nboundary \&quot;FrmTongHop\&quot; as F\ncontrol \&quot;ThamDinhService\&quot; as S\ndatabase \&quot;KetQuaRepository\&quot; as K\ndatabase \&quot;YeuCauYKienRepository\&quot; as Y\ndatabase \&quot;YKienRepository\&quot; as I\ndatabase \&quot;HoSoRepository\&quot; as H\n\nA -&gt; F : Chọn Tổng hợp kết quả\nF -&gt; S : tongHop(maHoSo)\n\nS -&gt; Y : kiemTraDayDuYKien(maHoSo)\nY --&gt; S : đủ / thiếu\n\nalt Chưa đủ ý kiến bắt buộc\n    S --&gt; F : Chưa được tổng hợp\nelse Đã đủ ý kiến\n    S -&gt; K : layKetQuaThamDinh(maHoSo)\n    K --&gt; S : các kết quả kiểm tra\n\n    S -&gt; I : layYKienLienNganh(maHoSo)\n    I --&gt; S : các ý kiến\n\n    S -&gt; S : xác định điều kiện\\nBắt buộc Không đạt\n\n    alt Không còn điều kiện bắt buộc chưa xử lý\n        S -&gt; H : cập nhật = Chờ phê duyệt\n    else Có điều kiện cho phép ngoại lệ\n        S --&gt; F : Cho phép UC27\n    else Có điều kiện không cho ngoại lệ\n        S -&gt; H : cập nhật = Không đủ điều kiện\n    end\nend\n\nS --&gt; F : kết quả tổng hợp\nF --&gt; A : Hiển thị\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LKEJ2Bqn9yLJKuePsXGK-537">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=15;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
