  <diagram id="Vh4TUFTwdvo1rYza-RvG" name="Workflow">
    <mxGraphModel dx="2010" dy="1092" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  DiamondBackgroundColor #FFF0C5\n}\n\nstart\n\n:UC03 - Tạo hồ sơ Nháp;\n\nif (Muốn chọn địa điểm?) then (Có)\n  :UC28 - Tra cứu và chọn địa điểm;\nendif\n\n:Hoàn thiện hồ sơ, vé/QR và quyền trình chiếu;\n:UC04 - Nộp hồ sơ;\n:Kiểm tra lại sức chứa và trùng lịch;\n\nif (Đủ điều kiện nộp?) then (Có)\n\n  :UC07 - Tiếp nhận hồ sơ;\n\n  :UC08 - Kiểm tra hợp lệ;\n\n  while (Hồ sơ cần bổ sung?) is (Có)\n    :Yêu cầu bổ sung;\n    :UC06 - Bổ sung hồ sơ;\n    :Nộp lại và kiểm tra;\n  endwhile (Không)\n\n  :UC09 - Thẩm định;\n  :UC10 - Kiểm tra địa điểm;\n  :UC11 - Kiểm tra an toàn;\n  :UC12 - Kiểm tra điều kiện;\n\n  :UC13 - Xin ý kiến liên ngành;\n\n  :UC14 - Các đơn vị gửi ý kiến;\n\n  while (Chưa nhận đủ ý kiến bắt buộc?) is (Có)\n    :Chờ các đơn vị phản hồi;\n  endwhile (Không)\n\n  :UC15 - Tổng hợp kết quả;\n\n  if (Có điều kiện bắt buộc không đạt?) then (Có)\n\n    if (Được phép đề xuất ngoại lệ?) then (Có)\n\n      :UC27 - Đề xuất ngoại lệ;\n      :UC18 - Quyết định ngoại lệ;\n\n      if (Ngoại lệ được chấp thuận?) then (Có)\n        :Chuyển Chờ phê duyệt;\n      else (Không)\n        :Kết luận không đủ điều kiện;\n        :UC17 - Từ chối cấp phép;\n        :UC26 - Gửi thông báo;\n        stop\n      endif\n\n    else (Không)\n\n      :Kết luận không đủ điều kiện;\n      :UC17 - Từ chối cấp phép;\n      :UC26 - Gửi thông báo;\n      stop\n\n    endif\n\n  else (Không)\n\n    :Chuyển Chờ phê duyệt;\n\n  endif\n\n  if (Người phê duyệt chấp thuận?) then (Có)\n\n    :UC16 - Phê duyệt cấp phép;\n    :UC19 - Cấp giấy phép;\n\n  else (Không)\n\n    :UC17 - Từ chối cấp phép;\n\n  endif\n\n  :UC26 - Gửi thông báo;\n\nelse (Không)\n\n  :Giữ trạng thái NHAP;\n  :Thông báo lý do không cho nộp;\n\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XCrKICa9WuZFL2Fzmvxr-1">
