        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam activityBackgroundColor #FFF8DC\nskinparam activityBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nstart\n\n:Chọn điều kiện Bắt buộc Không đạt;\n:Lấy quy tắc tương ứng;\n\nif (Quy tắc cho phép ngoại lệ?) then (Có)\n\n  if (Đã đủ ý kiến liên ngành?) then (Có)\n\n    :Nhập lý do đề xuất;\n    :Nhập/Tải minh chứng;\n    :Nhập biện pháp bù đắp;\n\n    if (Nội dung đề xuất đầy đủ?) then (Có)\n      :Xác định cấp thẩm quyền;\n      :Tạo Ngoại lệ trạng thái Chờ duyệt;\n      :Chuyển tới Người phê duyệt;\n      :Gửi thông báo;\n    else (Không)\n      :Yêu cầu bổ sung nội dung đề xuất;\n    endif\n\n  else (Không)\n    :Không cho đề xuất;\n    :Thông báo chưa đủ ý kiến liên ngành;\n  endif\n\nelse (Không)\n  :Không cho đề xuất ngoại lệ;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_KCB3ZGdKL114tAghsOc-809">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
