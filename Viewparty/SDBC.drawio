        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\n\ntitle HINH 4.1 - SO DO CO SO DU LIEU VIEW PARTY\n\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 40\nskinparam ranksep 50\n\nskinparam class {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  ArrowColor #A85B74\n  FontColor #222222\n}\n\nhide circle\nhide methods\n\nclass \&quot;DON_VI_LIEN_NGANH\&quot; as DV {\n  +ma_don_vi: BIGINT [PK]\n  --\n  ten_don_vi: NVARCHAR(200)\n  linh_vuc: NVARCHAR(150)\n  trang_thai: BIT\n}\n\nclass \&quot;TAI_KHOAN\&quot; as TK {\n  +ma_tai_khoan: BIGINT [PK]\n  --\n  ma_don_vi: BIGINT [FK, NULL]\n  ten_dang_nhap: VARCHAR(80)\n  mat_khau_bam: VARCHAR(255)\n  ho_ten: NVARCHAR(150)\n  email: VARCHAR(150)\n  so_dien_thoai: VARCHAR(20)\n  vai_tro: VARCHAR(30)\n  cap_tham_quyen: SMALLINT\n  trang_thai: VARCHAR(25)\n  ngay_tao: DATETIMEOFFSET\n}\n\nclass \&quot;LOAI_SU_KIEN\&quot; as LOAI {\n  +ma_loai_su_kien: BIGINT [PK]\n  --\n  ten_loai: NVARCHAR(150)\n  mo_ta: NVARCHAR(MAX)\n  trang_thai: BIT\n}\n\nclass \&quot;DIA_DIEM\&quot; as DD {\n  +ma_dia_diem: BIGINT [PK]\n  --\n  ten_dia_diem: NVARCHAR(200)\n  dia_chi: NVARCHAR(300)\n  suc_chua: INT\n  trang_thai: BIT\n}\n\nclass \&quot;HO_SO_CAP_PHEP\&quot; as HS {\n  +ma_ho_so: BIGINT [PK]\n  --\n  nguoi_to_chuc_id: BIGINT [FK]\n  nguoi_xu_ly_hien_tai_id: BIGINT [FK, NULL]\n  ma_loai_su_kien: BIGINT [FK]\n  ma_dia_diem: BIGINT [FK, NULL]\n  trang_thai: VARCHAR(30)\n  ngay_tao: DATETIMEOFFSET\n  ngay_nop: DATETIMEOFFSET\n  --\n  ten_su_kien: NVARCHAR(200)\n  bat_dau: DATETIMEOFFSET\n  ket_thuc: DATETIMEOFFSET\n  quy_mo: INT\n  noi_dung: NVARCHAR(MAX)\n  --\n  hinh_thuc_thuong_mai: VARCHAR(20)\n  co_tai_tro: BIT\n  thong_tin_tai_tro: NVARCHAR(MAX)\n  --\n  loai_ve: VARCHAR(20)\n  gia_ve: DECIMAL(14,2)\n  so_luong_ve: INT\n  kenh_phat_hanh_ve: NVARCHAR(MAX)\n  cach_kiem_soat_ve: NVARCHAR(MAX)\n  --\n  nhan_su_y_te: NVARCHAR(MAX)\n  nhan_su_an_ninh: NVARCHAR(MAX)\n  phuong_an_thoat_hiem: NVARCHAR(MAX)\n  phuong_an_xu_ly_su_co: NVARCHAR(MAX)\n  ly_do_tu_choi: NVARCHAR(MAX)\n}\n\nclass \&quot;QUYEN_TRINH_CHIEU\&quot; as QTC {\n  +ma_quyen: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK]\n  don_vi_cap: NVARCHAR(200)\n  so_van_ban: NVARCHAR(100)\n  loai_quyen: NVARCHAR(100)\n  nguon_tin_hieu: NVARCHAR(200)\n  noi_dung_duoc_cap: NVARCHAR(MAX)\n  pham_vi_dia_diem: NVARCHAR(MAX)\n  hieu_luc_tu: DATE\n  hieu_luc_den: DATE\n  tep_dinh_kem: NVARCHAR(500)\n  trang_thai: BIT\n}\n\nclass \&quot;TAI_LIEU\&quot; as TL {\n  +ma_tai_lieu: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK]\n  loai_tai_lieu: VARCHAR(50)\n  ten_tai_lieu: NVARCHAR(250)\n  duong_dan: NVARCHAR(500)\n  ngay_tai_len: DATETIMEOFFSET\n}\n\nclass \&quot;QUY_TAC\&quot; as QT {\n  +quy_tac_id: BIGINT [PK]\n  --\n  ma_loai_su_kien: BIGINT [FK]\n  ma_quy_tac: VARCHAR(60)\n  phien_ban: INT\n  nhom: NVARCHAR(80)\n  muc_do: VARCHAR(20)\n  dieu_kien_ap_dung: NVARCHAR(MAX)\n  dieu_kien_dat: NVARCHAR(MAX)\n  cho_phep_ngoai_le: BIT\n  cap_tham_quyen: SMALLINT\n  hieu_luc_tu: DATE\n  hieu_luc_den: DATE\n  trang_thai: BIT\n}\n\nclass \&quot;CAU_HINH_LIEN_NGANH\&quot; as CH {\n  +ma_cau_hinh: BIGINT [PK]\n  --\n  ma_loai_su_kien: BIGINT [FK]\n  ma_don_vi: BIGINT [FK]\n  quy_tac_id: BIGINT [FK, NULL]\n  bat_buoc: BIT\n  so_ngay_phan_hoi: INT\n  hieu_luc_tu: DATE\n  hieu_luc_den: DATE\n  trang_thai: BIT\n}\n\nclass \&quot;KET_QUA_KIEM_TRA\&quot; as KQ {\n  +ma_ket_qua: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK]\n  quy_tac_id: BIGINT [FK]\n  nguoi_kiem_tra_id: BIGINT [FK]\n  ket_qua: VARCHAR(20)\n  gia_tri_thuc_te: NVARCHAR(MAX)\n  ghi_chu: NVARCHAR(MAX)\n  ngay_danh_gia: DATETIMEOFFSET\n}\n\nclass \&quot;YEU_CAU_Y_KIEN\&quot; as YC {\n  +ma_yeu_cau: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK]\n  ma_don_vi: BIGINT [FK]\n  ma_cau_hinh: BIGINT [FK]\n  nguoi_gui_id: BIGINT [FK]\n  nguoi_phan_hoi_id: BIGINT [FK, NULL]\n  ngay_gui: DATETIMEOFFSET\n  han_phan_hoi: DATETIMEOFFSET\n  trang_thai: VARCHAR(20)\n  ket_luan: VARCHAR(30)\n  noi_dung_phan_hoi: NVARCHAR(MAX)\n  kien_nghi: NVARCHAR(MAX)\n  ngay_phan_hoi: DATETIMEOFFSET\n  tep_dinh_kem: NVARCHAR(500)\n}\n\nclass \&quot;NGOAI_LE\&quot; as NL {\n  +ma_ngoai_le: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK]\n  ma_ket_qua: BIGINT [FK, UNIQUE]\n  nguoi_de_xuat_id: BIGINT [FK]\n  nguoi_phe_duyet_id: BIGINT [FK, NULL]\n  ly_do: NVARCHAR(MAX)\n  minh_chung: NVARCHAR(MAX)\n  bien_phap_bu_dap: NVARCHAR(MAX)\n  cap_tham_quyen_yeu_cau: SMALLINT\n  trang_thai: VARCHAR(20)\n  ngay_de_xuat: DATETIMEOFFSET\n  ngay_quyet_dinh: DATETIMEOFFSET\n  ghi_chu_quyet_dinh: NVARCHAR(MAX)\n}\n\nclass \&quot;GIAY_PHEP\&quot; as GP {\n  +ma_giay_phep: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK, UNIQUE]\n  nguoi_phe_duyet_id: BIGINT [FK]\n  so_giay_phep: VARCHAR(80)\n  ngay_cap: DATE\n  hieu_luc_tu: DATE\n  hieu_luc_den: DATE\n  dieu_kien_kem_theo: NVARCHAR(MAX)\n}\n\nclass \&quot;LICH_SU_XU_LY\&quot; as LS {\n  +ma_lich_su: BIGINT [PK]\n  --\n  ma_ho_so: BIGINT [FK]\n  ma_tai_khoan: BIGINT [FK, NULL]\n  hanh_dong: NVARCHAR(100)\n  tu_trang_thai: VARCHAR(30)\n  den_trang_thai: VARCHAR(30)\n  ket_qua: NVARCHAR(100)\n  ghi_chu: NVARCHAR(MAX)\n  thoi_diem: DATETIMEOFFSET\n}\n\nclass \&quot;NHAT_KY_CAU_HINH\&quot; as NK {\n  +ma_nhat_ky: BIGINT [PK]\n  --\n  ma_tai_khoan: BIGINT [FK]\n  doi_tuong: NVARCHAR(80)\n  khoa_doi_tuong: NVARCHAR(120)\n  hanh_dong: NVARCHAR(50)\n  gia_tri_truoc: NVARCHAR(MAX)\n  gia_tri_sau: NVARCHAR(MAX)\n  thoi_diem: DATETIMEOFFSET\n}\n\nclass \&quot;THONG_BAO\&quot; as TB {\n  +ma_thong_bao: BIGINT [PK]\n  --\n  nguoi_nhan_id: BIGINT [FK]\n  ma_ho_so: BIGINT [FK, NULL]\n  loai_thong_bao: VARCHAR(40)\n  trang_thai: VARCHAR(20)\n  noi_dung: NVARCHAR(MAX)\n  thoi_diem_tao: DATETIMEOFFSET\n  thoi_diem_gui: DATETIMEOFFSET\n  so_lan_thu: INT\n}\n\n&#39; QUAN HE TAI KHOAN\n\nDV \&quot;0..1\&quot; -- \&quot;0..*\&quot; TK : thuoc don vi\n\n&#39; QUAN HE HO SO\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; HS : nguoi to chuc\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; HS : nguoi xu ly\n\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; HS : loai su kien\nDD \&quot;0..1\&quot; -- \&quot;0..*\&quot; HS : dia diem\n\nHS \&quot;1\&quot; -- \&quot;0..*\&quot; QTC : quyen trinh chieu\nHS \&quot;1\&quot; -- \&quot;0..*\&quot; TL : tai lieu\n\n&#39; QUAN HE CAU HINH\n\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; QT : quy tac\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; CH : cau hinh\n\nDV \&quot;1\&quot; -- \&quot;0..*\&quot; CH : don vi\nQT \&quot;0..1\&quot; -- \&quot;0..*\&quot; CH : quy tac lien quan\n\n&#39; QUAN HE THAM DINH\n\nHS \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : ket qua kiem tra\nQT \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : quy tac ap dung\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : nguoi kiem tra\n\n&#39; QUAN HE LIEN NGANH\n\nHS \&quot;1\&quot; -- \&quot;0..*\&quot; YC : yeu cau y kien\nDV \&quot;1\&quot; -- \&quot;0..*\&quot; YC : don vi nhan\nCH \&quot;1\&quot; -- \&quot;0..*\&quot; YC : cau hinh ap dung\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; YC : nguoi gui\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; YC : nguoi phan hoi\n\n&#39; QUAN HE NGOAI LE\n\nHS \&quot;1\&quot; -- \&quot;0..*\&quot; NL : de xuat ngoai le\nKQ \&quot;1\&quot; -- \&quot;0..1\&quot; NL : can cu ngoai le\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; NL : nguoi de xuat\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; NL : nguoi phe duyet\n\n&#39; QUAN HE GIAY PHEP\n\nHS \&quot;1\&quot; -- \&quot;0..1\&quot; GP : cap giay phep\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; GP : phe duyet\n\n&#39; QUAN HE LICH SU\n\nHS \&quot;1\&quot; -- \&quot;0..*\&quot; LS : lich su\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; LS : nguoi thao tac\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; NK : ghi nhat ky\n\n&#39; QUAN HE THONG BAO\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; TB : nguoi nhan\nHS \&quot;0..1\&quot; -- \&quot;0..*\&quot; TB : ho so lien quan\n\nnote right of DD\n  UC28 - Tra cuu va chon dia diem.\n\n  Chi gan MaDiaDiem cho ho so Nhap.\n  Khong giu cho khi chon.\nend note\n\nnote bottom of HS\n  HO_SO_CAP_PHEP tich hop:\n  - Thong tin su kien\n  - Phuong an ve / QR\n  - Phuong an an toan\n\n  UC04 kiem tra lai dia diem,\n  suc chua va trung lich khi nop.\nend note\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uJYb7ejt41ROxG3xYC2D-1093">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
