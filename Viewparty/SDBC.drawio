        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam sequence {\n  ParticipantBackgroundColor #FFF8DC\n  ParticipantBorderColor #A85B74\n  ArrowColor #A85B74\n}\n\nactor \&quot;Người tổ chức\&quot; as NTC\nboundary \&quot;FrmHoSo\&quot; as UI\ncontrol \&quot;HoSoService\&quot; as HS\nentity \&quot;HoSoRepository\&quot; as HR\ndatabase \&quot;SQL Server\&quot; as DB\n\nNTC -&gt; UI : Chọn Nộp hồ sơ\nUI -&gt; HS : NopHoSo(maHoSo)\n\nHS -&gt; HS : Kiểm tra quyền sở hữu\nHS -&gt; HS : Kiểm tra trạng thái NHAP\nHS -&gt; HS : Kiểm tra quy mô 1000-10000\nHS -&gt; HS : Kiểm tra thời hạn &gt;= 30 ngày\nHS -&gt; HS : Kiểm tra vé/QR và quyền trình chiếu\nHS -&gt; HS : Kiểm tra đã chọn địa điểm\n\nalt Không đủ điều kiện\n  HS --&gt; UI : Từ chối và trả lý do\n  UI --&gt; NTC : Yêu cầu chỉnh sửa\n\nelse Đủ điều kiện ban đầu\n  HS -&gt; HR : NopHoSoTrongTransaction()\n\n  HR -&gt; DB : BEGIN TRANSACTION\n  HR -&gt; DB : Khóa và đọc lại hồ sơ, địa điểm\n  HR -&gt; DB : Kiểm tra sức chứa\n  HR -&gt; DB : Kiểm tra trùng lịch với hồ sơ đã giữ chỗ\n  DB --&gt; HR : Kết quả kiểm tra\n\n  alt Địa điểm hợp lệ, không trùng lịch\n    HR -&gt; DB : UPDATE trạng thái DA_NOP\n    HR -&gt; DB : Ghi ngày nộp\n    HR -&gt; DB : INSERT LICH_SU_XU_LY\n    HR -&gt; DB : COMMIT TRANSACTION\n\n    DB --&gt; HR : Thành công\n    HR --&gt; HS : Nộp thành công\n    HS --&gt; UI : Hồ sơ DA_NOP\n\n  else Địa điểm không còn phù hợp\n    HR -&gt; DB : ROLLBACK TRANSACTION\n    HR --&gt; HS : Nộp thất bại\n    HS --&gt; UI : Thông báo lý do\n  end\n\n  UI --&gt; NTC : Hiển thị kết quả\nend\n\nnote over HR,DB\n  Kiểm tra lịch phải được đồng bộ\n  giữa các giao dịch nộp đồng thời.\n  Không dựa vào kết quả UC28 cũ.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lx9Sh0RKUkfK1Wfze3iJ-158">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
