  <diagram id="3NoL-q5BU3_SJ8P7PgZB" name="Trang-10">
    <mxGraphModel dx="2416" dy="863" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam ArrowColor #A85B74\nskinparam actorStyle stickman\nskinparam packageStyle rectangle\n\nskinparam usecase {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  FontColor #222222\n}\n\nactor \&quot;Người tổ chức\\nsự kiện\&quot; as NTC\n\nrectangle \&quot;PHÂN RÃ USE CASE - QUẢN LÝ HỒ SƠ\&quot; {\n\n  usecase \&quot;UC03\\nTạo hồ sơ cấp phép\&quot; as UC03\n\n  usecase \&quot;UC28\\nTra cứu và lựa chọn\\nđịa điểm\&quot; as UC28\n\n  usecase \&quot;UC04\\nNộp hồ sơ cấp phép\&quot; as UC04\n\n  usecase \&quot;UC05\\nTheo dõi trạng thái\\nhồ sơ\&quot; as UC05\n\n  usecase \&quot;UC06\\nBổ sung hồ sơ\&quot; as UC06\n\n}\n\nNTC -- UC03\nNTC -- UC28\nNTC -- UC04\nNTC -- UC05\nNTC -- UC06\n\nUC28 ..&gt; UC03 : &lt;&lt;extend&gt;&gt;\nUC06 ..&gt; UC05 : &lt;&lt;extend&gt;&gt;\n\nnote right of UC28\n  Điều kiện mở rộng UC03:\n  Người tổ chức chọn địa điểm\n  khi đang lập hồ sơ Nháp.\n\n  Chưa giữ chỗ địa điểm.\nend note\n\nnote right of UC06\n  Điều kiện mở rộng UC05:\n  Hồ sơ có yêu cầu bổ sung\n  và người tổ chức chọn\n  thao tác bổ sung hồ sơ.\nend note\n\nnote bottom of UC04\n  Khi nộp phải kiểm tra lại\n  sức chứa và trùng lịch.\n  Không dùng UC28 thay cho\n  kiểm tra điều kiện nộp.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="g0oCaI_5Rve2QDrYmSqa-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
