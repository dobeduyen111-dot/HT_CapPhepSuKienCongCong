        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam ArrowFontSize 18\nskinparam stateBackgroundColor #FFF8DC\nskinparam stateBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\nskinparam roundCorner 10\n\nhide empty description\n\nstate \&quot;Nháp\&quot; as Nhap\nstate \&quot;Đã nộp\&quot; as DaNop\nstate \&quot;Đang kiểm tra\&quot; as DangKiemTra\nstate \&quot;Yêu cầu bổ sung\&quot; as YeuCauBoSung\nstate \&quot;Đang thẩm định\&quot; as DangThamDinh\nstate \&quot;Chờ ý kiến liên ngành\&quot; as ChoYKienLienNganh\nstate \&quot;Tổng hợp kết quả\&quot; as TongHopKetQua\nstate \&quot;Xử lý ngoại lệ\&quot; as XuLyNgoaiLe\nstate \&quot;Không đủ điều kiện\&quot; as KhongDuDieuKien\nstate \&quot;Chờ phê duyệt\&quot; as ChoPheDuyet\nstate \&quot;Đã cấp phép\&quot; as DaCapPhep\nstate \&quot;Từ chối\&quot; as TuChoi\n\n[*] --&gt; Nhap : tạo hồ sơ\n\nNhap --&gt; DaNop : nộp hồ sơ\\n[đạt điều kiện tiếp nhận]\n\nDaNop --&gt; DangKiemTra : tiếp nhận hồ sơ\n\nDangKiemTra --&gt; YeuCauBoSung : thiếu / sai\\ncó thể khắc phục\n\nYeuCauBoSung --&gt; DaNop : bổ sung và nộp lại\n\nDangKiemTra --&gt; DangThamDinh : hồ sơ hợp lệ\n\nDangThamDinh --&gt; ChoYKienLienNganh : hoàn tất thẩm định ban đầu\n\nChoYKienLienNganh --&gt; TongHopKetQua : đã nhận đủ\\ný kiến bắt buộc\n\nTongHopKetQua --&gt; ChoPheDuyet : không còn điều kiện\\nBắt buộc chưa xử lý\n\nTongHopKetQua --&gt; XuLyNgoaiLe : có điều kiện Bắt buộc Không đạt\\nvà cho phép ngoại lệ\n\nTongHopKetQua --&gt; KhongDuDieuKien : có điều kiện Bắt buộc Không đạt\\nvà không cho ngoại lệ\n\nXuLyNgoaiLe --&gt; TongHopKetQua : ngoại lệ được chấp thuận\n\nXuLyNgoaiLe --&gt; KhongDuDieuKien : ngoại lệ bị từ chối\n\nKhongDuDieuKien --&gt; TuChoi : ra quyết định từ chối\n\nChoPheDuyet --&gt; DaCapPhep : phê duyệt cấp phép\n\nChoPheDuyet --&gt; TuChoi : từ chối cấp phép\n\nDaCapPhep --&gt; [*]\n\nTuChoi --&gt; [*]\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="P-UnliherPvBlTEUAyls-83">
