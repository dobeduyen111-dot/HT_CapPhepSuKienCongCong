        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam activityBackgroundColor #FFF8DC\nskinparam activityBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nstart\n\n:Mở đề xuất ngoại lệ;\n:Kiểm tra cấp thẩm quyền;\n\nif (Đủ thẩm quyền?) then (Có)\n\n  if (Người duyệt khác Người đề xuất?) then (Có)\n\n    :Xem kết quả kiểm tra;\n    :Xem ý kiến liên ngành;\n    :Xem lý do, minh chứng,\\nbiện pháp bù đắp;\n\n    if (Chấp thuận ngoại lệ?) then (Có)\n      :Lưu Đã chấp thuận;\n    else (Không)\n      :Lưu Bị từ chối;\n    endif\n\n    :Gửi thông báo kết quả;\n\n  else (Không)\n    :Chặn thao tác;\n    :Thông báo người duyệt trùng người đề xuất;\n  endif\n\nelse (Không)\n  :Chặn thao tác;\n  :Thông báo không đủ thẩm quyền;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_KCB3ZGdKL114tAghsOc-510">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
