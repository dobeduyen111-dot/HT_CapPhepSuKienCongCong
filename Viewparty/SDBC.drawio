  <diagram id="Ub2c5BcdpLRvEoZAsqMk" name="Trang-7">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle HINH 3.29 - BIEU DO LOP CHI TIET HE THONG VIEW PARTY\n\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 40\nskinparam ranksep 50\n\nskinparam class {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  ArrowColor #A85B74\n  FontColor #222222\n}\n\nhide circle\n\nclass \&quot;TaiKhoan\&quot; as TK {\n  +MaTaiKhoan: long [PK]\n  +MaDonVi: long? [FK]\n  +TenDangNhap: string\n  +MatKhauBam: string\n  +HoTen: string\n  +Email: string\n  +SoDienThoai: string?\n  +VaiTro: string\n  +CapThamQuyen: short?\n  +TrangThai: string\n  +NgayTao: DateTimeOffset\n  --\n  +CoVaiTro(vaiTro: string): bool\n  +DangHoatDong(): bool\n  +DuThamQuyen(cap: short): bool\n}\n\nclass \&quot;DonViLienNganh\&quot; as DV {\n  +MaDonVi: long [PK]\n  +TenDonVi: string\n  +LinhVuc: string\n  +TrangThai: bool\n  --\n  +DangHoatDong(): bool\n}\n\nclass \&quot;LoaiSuKien\&quot; as LOAI {\n  +MaLoaiSuKien: long [PK]\n  +TenLoai: string\n  +MoTa: string?\n  +TrangThai: bool\n  --\n  +DangHoatDong(): bool\n}\n\nclass \&quot;DiaDiem\&quot; as DD {\n  +MaDiaDiem: long [PK]\n  +TenDiaDiem: string\n  +DiaChi: string\n  +SucChua: int\n  +TrangThai: bool\n  --\n  +DangHoatDong(): bool\n  +DuSucChua(quyMo: int): bool\n}\n\nclass \&quot;HoSoCapPhep\&quot; as HS {\n  +MaHoSo: long [PK]\n  +NguoiToChucId: long [FK]\n  +NguoiXuLyHienTaiId: long? [FK]\n  +MaLoaiSuKien: long [FK]\n  +MaDiaDiem: long? [FK]\n  +TrangThai: string\n  +NgayTao: DateTimeOffset\n  +NgayNop: DateTimeOffset?\n\n  .. Thông tin sự kiện ..\n  +TenSuKien: string\n  +BatDau: DateTimeOffset\n  +KetThuc: DateTimeOffset\n  +QuyMo: int\n  +NoiDung: string\n\n  .. Hình thức tổ chức ..\n  +HinhThucThuongMai: string\n  +CoTaiTro: bool\n  +ThongTinTaiTro: string?\n\n  .. Phương án vé ..\n  +LoaiVe: string\n  +GiaVe: decimal?\n  +SoLuongVe: int\n  +KenhPhatHanhVe: string\n  +CachKiemSoatVe: string\n\n  .. Phương án an toàn ..\n  +NhanSuYTe: string\n  +NhanSuAnNinh: string\n  +PhuongAnThoatHiem: string\n  +PhuongAnXuLySuCo: string\n  +LyDoTuChoi: string?\n\n  --\n  +LaHoSoNhap(): bool\n  +CoDiaDiem(): bool\n  +KiemTraQuyMo(): bool\n  +KiemTraThoiGian(): bool\n  +GanDiaDiem(maDiaDiem: long): void\n}\n\nclass \&quot;QuyenTrinhChieu\&quot; as QTC {\n  +MaQuyen: long [PK]\n  +MaHoSo: long [FK]\n  +DonViCap: string\n  +SoVanBan: string?\n  +LoaiQuyen: string\n  +NguonTinHieu: string\n  +NoiDungDuocCap: string\n  +PhamViDiaDiem: string\n  +HieuLucTu: DateTime\n  +HieuLucDen: DateTime\n  +TepDinhKem: string?\n  +TrangThai: bool\n  --\n  +ConHieuLuc(ngay: DateTime): bool\n  +DangHoatDong(): bool\n}\n\nclass \&quot;TaiLieu\&quot; as TL {\n  +MaTaiLieu: long [PK]\n  +MaHoSo: long [FK]\n  +LoaiTaiLieu: string\n  +TenTaiLieu: string\n  +DuongDan: string\n  +NgayTaiLen: DateTimeOffset\n  --\n  +CoDuongDan(): bool\n}\n\nclass \&quot;QuyTac\&quot; as QT {\n  +QuyTacId: long [PK]\n  +MaQuyTac: string\n  +PhienBan: int\n  +MaLoaiSuKien: long [FK]\n  +Nhom: string\n  +MucDo: string\n  +DieuKienApDung: string\n  +DieuKienDat: string\n  +ChoPhepNgoaiLe: bool\n  +CapThamQuyen: short?\n  +HieuLucTu: DateTime\n  +HieuLucDen: DateTime?\n  +TrangThai: bool\n  --\n  +DangHieuLuc(ngay: DateTime): bool\n  +LaBatBuoc(): bool\n  +DuocPhepNgoaiLe(): bool\n}\n\nclass \&quot;CauHinhLienNganh\&quot; as CH {\n  +MaCauHinh: long [PK]\n  +MaLoaiSuKien: long [FK]\n  +MaDonVi: long [FK]\n  +QuyTacId: long? [FK]\n  +BatBuoc: bool\n  +SoNgayPhanHoi: int\n  +HieuLucTu: DateTime\n  +HieuLucDen: DateTime?\n  +TrangThai: bool\n  --\n  +DangHieuLuc(ngay: DateTime): bool\n  +TinhHanPhanHoi(ngayGui: DateTime): DateTime\n}\n\nclass \&quot;KetQuaKiemTra\&quot; as KQ {\n  +MaKetQua: long [PK]\n  +MaHoSo: long [FK]\n  +QuyTacId: long [FK]\n  +NguoiKiemTraId: long [FK]\n  +KetQua: string\n  +GiaTriThucTe: string?\n  +GhiChu: string?\n  +NgayDanhGia: DateTimeOffset\n  --\n  +LaDat(): bool\n  +LaKhongDat(): bool\n  +LaCanhBao(): bool\n}\n\nclass \&quot;YeuCauYKien\&quot; as YC {\n  +MaYeuCau: long [PK]\n  +MaHoSo: long [FK]\n  +MaDonVi: long [FK]\n  +MaCauHinh: long [FK]\n  +NguoiGuiId: long [FK]\n  +NgayGui: DateTimeOffset\n  +HanPhanHoi: DateTimeOffset\n  +TrangThai: string\n  +NguoiPhanHoiId: long? [FK]\n  +KetLuan: string?\n  +NoiDungPhanHoi: string?\n  +KienNghi: string?\n  +NgayPhanHoi: DateTimeOffset?\n  +TepDinhKem: string?\n  --\n  +DaPhanHoi(): bool\n  +QuaHan(hienTai: DateTimeOffset): bool\n  +LaYKienBatBuoc(): bool\n}\n\nclass \&quot;NgoaiLe\&quot; as NL {\n  +MaNgoaiLe: long [PK]\n  +MaHoSo: long [FK]\n  +MaKetQua: long [FK]\n  +NguoiDeXuatId: long [FK]\n  +NguoiPheDuyetId: long? [FK]\n  +LyDo: string\n  +MinhChung: string\n  +BienPhapBuDap: string\n  +CapThamQuyenYeuCau: short\n  +TrangThai: string\n  +NgayDeXuat: DateTimeOffset\n  +NgayQuyetDinh: DateTimeOffset?\n  +GhiChuQuyetDinh: string?\n  --\n  +DangChoDuyet(): bool\n  +DaChapThuan(): bool\n  +NguoiDuyetHopLe(): bool\n}\n\nclass \&quot;GiayPhep\&quot; as GP {\n  +MaGiayPhep: long [PK]\n  +MaHoSo: long [FK, UNIQUE]\n  +NguoiPheDuyetId: long [FK]\n  +SoGiayPhep: string\n  +NgayCap: DateTime\n  +HieuLucTu: DateTime\n  +HieuLucDen: DateTime\n  +DieuKienKemTheo: string?\n  --\n  +ConHieuLuc(ngay: DateTime): bool\n}\n\nclass \&quot;LichSuXuLy\&quot; as LS {\n  +MaLichSu: long [PK]\n  +MaHoSo: long [FK]\n  +MaTaiKhoan: long? [FK]\n  +HanhDong: string\n  +TuTrangThai: string?\n  +DenTrangThai: string?\n  +KetQua: string?\n  +GhiChu: string?\n  +ThoiDiem: DateTimeOffset\n}\n\nclass \&quot;NhatKyCauHinh\&quot; as NK {\n  +MaNhatKy: long [PK]\n  +MaTaiKhoan: long [FK]\n  +DoiTuong: string\n  +KhoaDoiTuong: string?\n  +HanhDong: string\n  +GiaTriTruoc: string?\n  +GiaTriSau: string?\n  +ThoiDiem: DateTimeOffset\n}\n\nclass \&quot;ThongBao\&quot; as TB {\n  +MaThongBao: long [PK]\n  +NguoiNhanId: long [FK]\n  +MaHoSo: long? [FK]\n  +LoaiThongBao: string\n  +TrangThai: string\n  +NoiDung: string\n  +ThoiDiemTao: DateTimeOffset\n  +ThoiDiemGui: DateTimeOffset?\n  +SoLanThu: int\n  --\n  +DaGui(): bool\n  +CanGuiLai(): bool\n}\n\n&#39; NGUOI DUNG VA HO SO\n\nDV \&quot;0..1\&quot; -- \&quot;0..*\&quot; TK : thuộc đơn vị\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; HS : người tổ chức\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; HS : người xử lý\n\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; HS : phân loại\nDD \&quot;0..1\&quot; -- \&quot;0..*\&quot; HS : địa điểm\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; QTC : quyền trình chiếu\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; TL : tài liệu\n\n&#39; CAU HINH VA THAM DINH\n\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; QT : áp dụng\nLOAI \&quot;1\&quot; -- \&quot;0..*\&quot; CH : cấu hình\n\nDV \&quot;1\&quot; -- \&quot;0..*\&quot; CH : đơn vị\nQT \&quot;0..1\&quot; -- \&quot;0..*\&quot; CH : quy tắc liên quan\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; KQ : kết quả\nQT \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : phiên bản quy tắc\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; KQ : kiểm tra\n\n&#39; Y KIEN LIEN NGANH\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; YC : yêu cầu\n\nDV \&quot;1\&quot; -- \&quot;0..*\&quot; YC : đơn vị nhận\nCH \&quot;1\&quot; -- \&quot;0..*\&quot; YC : cấu hình\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; YC : gửi yêu cầu\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; YC : phản hồi\n\n&#39; NGOAI LE VA QUYET DINH\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; NL : ngoại lệ\nKQ \&quot;1\&quot; -- \&quot;0..1\&quot; NL : kết quả gốc\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; NL : đề xuất\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; NL : quyết định\n\n&#39; GIAY PHEP\n\nHS \&quot;1\&quot; -- \&quot;0..1\&quot; GP : cấp giấy phép\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; GP : phê duyệt\n\n&#39; LICH SU, NHAT KY, THONG BAO\n\nHS \&quot;1\&quot; *-- \&quot;0..*\&quot; LS : lịch sử\nTK \&quot;0..1\&quot; -- \&quot;0..*\&quot; LS : thao tác\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; NK : nhật ký cấu hình\n\nTK \&quot;1\&quot; -- \&quot;0..*\&quot; TB : người nhận\nHS \&quot;0..1\&quot; -- \&quot;0..*\&quot; TB : hồ sơ liên quan\n\nnote right of HS\n  UC03: Tạo và lưu Nháp.\n\n  UC28: Gán MaDiaDiem cho Nháp.\n\n  UC04: Kiểm tra điều kiện nộp,\n  sức chứa và trùng lịch\n  trong transaction.\n\n  Chỉ UC04 mới giữ chỗ.\nend note\n\nnote bottom of QT\n  Quy tắc được phiên bản hóa.\n\n  Kết quả kiểm tra tham chiếu\n  QuyTacId của đúng phiên bản\n  đã sử dụng.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="H4coR9q6LceyR1J0YsJ6-1573">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
