        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nskinparam shadowing false\nskinparam actorStyle stickman\nskinparam defaultFontName \&quot;Times New Roman\&quot;\n\nactor \&quot;Người phê duyệt\&quot; as PD\n\nrectangle \&quot;PHÊ DUYỆT - CẤP PHÉP\&quot; {\n\n    usecase \&quot;UC16\\nPhê duyệt cấp phép\&quot; as U16\n\n    usecase \&quot;UC17\\nTừ chối cấp phép\&quot; as U17\n\n    usecase \&quot;UC19\\nCấp giấy phép\&quot; as U19\n}\n\nPD -- U16\nPD -- U17\n\nU16 ..&gt; U19 : &lt;&lt;include&gt;&gt;\n\nnote right of U17\nÁp dụng khi:\n- Hồ sơ được kết luận\n  Không đủ điều kiện; hoặc\n- Người phê duyệt không\n  chấp thuận cấp phép.\nend note\n\nnote right of U19\nUC19 là xử lý nội bộ.\nHệ thống tạo giấy phép sau\nquyết định phê duyệt hợp lệ.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="0qgI6s74EG2qIscQOJ1v-62">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
