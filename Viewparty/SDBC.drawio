        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  DiamondBackgroundColor #FFF0C5\n}\n\nstart\n\n:Người tổ chức chọn Nộp hồ sơ;\n:Kiểm tra quyền sở hữu;\n:Kiểm tra trạng thái NHAP;\n:Kiểm tra thông tin và tài liệu;\n\nif (Dữ liệu hồ sơ đầy đủ?) then (Có)\n\n  if (Quy mô từ 1000 đến 10000?) then (Có)\n\n    if (Nộp trước ít nhất 30 ngày?) then (Có)\n\n      if (Vé/QR và quyền trình chiếu hợp lệ?) then (Có)\n\n        if (Đã chọn địa điểm?) then (Có)\n\n          :BEGIN TRANSACTION;\n          :Khóa và đọc lại dữ liệu liên quan;\n          :Kiểm tra địa điểm hoạt động;\n          :Kiểm tra sức chứa;\n          :Kiểm tra trùng lịch;\n\n          if (Địa điểm đủ điều kiện?) then (Có)\n\n            :Cập nhật trạng thái DA_NOP;\n            :Ghi ngày nộp;\n            :Ghi lịch sử xử lý;\n            :COMMIT TRANSACTION;\n            :Thông báo nộp thành công;\n\n          else (Không)\n\n            :ROLLBACK TRANSACTION;\n            :Thông báo địa điểm không phù hợp;\n\n          endif\n\n        else (Không)\n\n          :Yêu cầu lựa chọn địa điểm;\n\n        endif\n\n      else (Không)\n\n        :Thông báo phương án vé/quyền không hợp lệ;\n\n      endif\n\n    else (Không)\n\n      :Thông báo không đủ thời hạn nộp;\n\n    endif\n\n  else (Không)\n\n    :Thông báo quy mô không hợp lệ;\n\n  endif\n\nelse (Không)\n\n  :Thông báo hồ sơ chưa đầy đủ;\n\nendif\n\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="n8Gjqb5mg1hr0XabP9dd-58">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
