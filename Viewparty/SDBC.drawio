        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam shadowing false\nskinparam sequence {\n  ParticipantBackgroundColor #FFF8DC\n  ParticipantBorderColor #A85B74\n  ArrowColor #A85B74\n}\n\nactor \&quot;Người tổ chức\&quot; as NTC\nboundary \&quot;FrmHoSo\&quot; as UI\nboundary \&quot;FrmChonDiaDiem\&quot; as DD\ncontrol \&quot;HoSoService\&quot; as HS\ncontrol \&quot;DiaDiemService\&quot; as DS\nentity \&quot;HoSoRepository\&quot; as HR\nentity \&quot;DiaDiemRepository\&quot; as DR\ndatabase \&quot;SQL Server\&quot; as DB\n\nNTC -&gt; UI : Chọn Tạo hồ sơ\nUI -&gt; HS : TaoHoSoNhap()\nHS -&gt; HR : TaoNhap()\nHR -&gt; DB : INSERT HO_SO_CAP_PHEP\nDB --&gt; HR : MaHoSo\nHR --&gt; HS : MaHoSo\nHS --&gt; UI : Hồ sơ NHAP\n\nNTC -&gt; UI : Nhập thông tin sự kiện\nNTC -&gt; UI : Khai báo vé/QR\nNTC -&gt; UI : Khai báo quyền trình chiếu\nNTC -&gt; UI : Nhập an toàn và tài liệu\n\nopt Chọn địa điểm trong lúc lập hồ sơ\n  NTC -&gt; UI : Nhấn Chọn địa điểm\n  UI -&gt; DD : Mở UC28\n\n  DD -&gt; DS : TraCuu(dieuKien)\n  DS -&gt; DR : TimDiaDiem()\n  DR -&gt; DB : SELECT DIA_DIEM và lịch tham khảo\n  DB --&gt; DR : Danh sách\n  DR --&gt; DS : Kết quả\n  DS --&gt; DD : Hiển thị danh sách\n\n  NTC -&gt; DD : Chọn địa điểm\n  DD -&gt; HS : ChonDiaDiem(maHoSo, maDiaDiem)\n\n  HS -&gt; HS : Kiểm tra quyền và trạng thái NHAP\n\n  alt Hợp lệ\n    HS -&gt; HR : GanDiaDiem()\n    HR -&gt; DB : UPDATE HO_SO_CAP_PHEP\n    DB --&gt; HR : Thành công\n    HS --&gt; DD : Chọn thành công\n    DD --&gt; UI : Trả MaDiaDiem\n  else Không hợp lệ\n    HS --&gt; DD : Thông báo lỗi\n  end\nend\n\nNTC -&gt; UI : Chọn Lưu Nháp\nUI -&gt; HS : LuuNhap(thongTin)\nHS -&gt; HS : Kiểm tra dữ liệu\n\nalt Dữ liệu hợp lệ\n  HS -&gt; HR : CapNhatNhap()\n  HR -&gt; DB : UPDATE hồ sơ và dữ liệu liên quan\n  DB --&gt; HR : Thành công\n  HR --&gt; HS : Đã lưu\n  HS --&gt; UI : Lưu Nháp thành công\nelse Không hợp lệ\n  HS --&gt; UI : Thông báo trường cần sửa\nend\n\nUI --&gt; NTC : Hiển thị kết quả\n\nnote over DD,DB\n  Không giữ chỗ khi lưu Nháp.\n  MaDiaDiem có thể để NULL.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lx9Sh0RKUkfK1Wfze3iJ-79">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
