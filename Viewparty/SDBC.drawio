        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\n\nskinparam shadowing false\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam ArrowColor #A85B74\nskinparam actorStyle stickman\nskinparam linetype polyline\n\nskinparam usecase {\n  BackgroundColor #FFF8DC\n  BorderColor #A85B74\n  FontColor #222222\n}\n\nactor \&quot;Quản trị viên\&quot; as QT\n\nrectangle \&quot;PHÂN RÃ USE CASE - QUẢN TRỊ CẤU HÌNH\&quot; {\n\n  usecase \&quot;UC20\\nQuản lý tài khoản\\nvà phân quyền\&quot; as UC20\n\n  usecase \&quot;UC21\\nCấu hình loại sự kiện\&quot; as UC21\n\n  usecase \&quot;UC22\\nCấu hình quy tắc\\nvà điều kiện cấp phép\&quot; as UC22\n\n  usecase \&quot;UC23\\nCấu hình yêu cầu\\nlấy ý kiến liên ngành\&quot; as UC23\n\n  usecase \&quot;UC24\\nQuản lý người\\nphê duyệt\&quot; as UC24\n\n  usecase \&quot;UC25\\nXem lịch sử xử lý\\nvà nhật ký cấu hình\&quot; as UC25\n}\n\nQT -- UC20\nQT -- UC21\nQT -- UC22\nQT -- UC23\nQT -- UC24\nQT -- UC25\n\nnote right of UC20\n  Quản lý tài khoản nội bộ,\n  gán vai trò và phân quyền.\n\n  Người tổ chức tự đăng ký bằng UC01.\nend note\n\nnote right of UC22\n  Cấu hình điều kiện áp dụng,\n  điều kiện đạt, ngoại lệ,\n  thẩm quyền và hiệu lực.\n\n  Thay đổi quy tắc phải\n  tạo phiên bản mới.\nend note\n\nnote right of UC23\n  Cấu hình các đơn vị liên ngành\n  cần lấy ý kiến và các yêu cầu\n  bắt buộc theo loại sự kiện.\nend note\n\nnote right of UC24\n  Quản lý người phê duyệt\n  và cấp thẩm quyền.\nend note\n\nnote right of UC25\n  Xem lịch sử xử lý và nhật ký\n  cấu hình đã được lưu.\n\n  Không chỉnh sửa lịch sử.\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7vILHQm5s8omMgMBvrmK-43">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
