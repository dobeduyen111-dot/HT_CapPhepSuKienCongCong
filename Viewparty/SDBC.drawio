        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntop to bottom direction\n\nskinparam defaultFontName \&quot;Times New Roman\&quot;\nskinparam defaultFontSize 20\nskinparam activityBackgroundColor #FFF8DC\nskinparam activityBorderColor #C0504D\nskinparam ArrowColor #C0504D\nskinparam shadowing false\n\nstart\n\n:Chọn Nộp hồ sơ;\n\nif (Quy mô từ 1.000 đến 10.000?) then (Có)\n\n  if (Nộp trước ít nhất 30 ngày?) then (Có)\n\n    if (Quy mô không vượt sức chứa?) then (Có)\n\n      if (Địa điểm không trùng lịch?) then (Có)\n\n        if (Phương án vé hợp lệ?) then (Có)\n\n          if (Quyền trình chiếu hợp lệ?) then (Có)\n            :Tạo giữ chỗ địa điểm;\n            :Ghi ngày nộp;\n            :Cập nhật trạng thái Đã nộp;\n            :Ghi lịch sử xử lý;\n          else (Không)\n            :Không cho nộp;\n            :Thông báo quyền trình chiếu không hợp lệ;\n          endif\n\n        else (Không)\n          :Không cho nộp;\n          :Thông báo phương án vé không hợp lệ;\n        endif\n\n      else (Không)\n        :Không cho nộp;\n        :Thông báo địa điểm trùng lịch;\n      endif\n\n    else (Không)\n      :Không cho nộp;\n      :Thông báo vượt sức chứa;\n    endif\n\n  else (Không)\n    :Không cho nộp;\n    :Thông báo không đủ thời hạn 30 ngày;\n  endif\n\nelse (Không)\n  :Không cho nộp;\n  :Thông báo quy mô ngoài phạm vi;\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_KCB3ZGdKL114tAghsOc-90">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;shadow=0;fontSize=20;fontFamily=Times New Roman;" plantUmlBaseValue="" id="_KCB3ZGdKL114tAghsOc-91">
