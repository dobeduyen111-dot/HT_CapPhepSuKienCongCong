<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Cấu hình đang dùng: LocalDB -->
    <add name="ViewPartyDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=ViewPartyDB_UC28;Integrated Security=True;Connect Timeout=30;"
         providerName="System.Data.SqlClient" />

    <!-- Nếu dùng SQL Express, đổi ViewPartyDb ở trên thành chuỗi này. -->
  </connectionStrings>

  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
