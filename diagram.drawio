        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Class Diagram - UC01 Đăng ký tài khoản\n\nclass User {\n    - userId : int\n    - fullName : String\n    - email : String\n    - phone : String\n    - password : String\n    - status : String\n    - createdAt : DateTime\n    --\n    + register() : void\n    + updateInformation() : void\n}\n\nclass Role {\n    - roleId : int\n    - roleName : String\n    - description : String\n}\n\nclass UserService {\n    + register(user : User) : boolean\n    + checkAccountExists(email : String) : boolean\n    + createAccount(user : User) : User\n}\n\nclass UserRepository {\n    + findByEmail(email : String) : User\n    + save(user : User) : User\n}\n\nUser \&quot;N\&quot; --&gt; \&quot;1\&quot; Role : thuộc vai trò\nUserService --&gt; UserRepository : sử dụng\nUserService --&gt; User : quản lý\nUserService --&gt; Role : gán vai trò\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="51L6HeP-Vf7L5IxZ7wsv-80">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
