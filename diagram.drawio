        <UserObject label="Activity Diagram - UC08 Kiểm tra tính hợp lệ hồ sơ" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram - UC08 Kiểm tra tính hợp lệ hồ sơ" id="6SYEwyuJK9MHmqEQbmld-28">
