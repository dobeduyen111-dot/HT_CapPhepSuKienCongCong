        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC07 Tiếp nhận hồ sơ\n\nactor \&quot;Người xử lý hồ sơ\&quot; as Officer\nboundary \&quot;Giao diện xử lý hồ sơ\&quot; as UI\ncontrol \&quot;Hệ thống\&quot; as System\ndatabase \&quot;Cơ sở dữ liệu\&quot; as DB\n\nOfficer -&gt; UI: 1. Mở danh sách hồ sơ đã nộp\nUI -&gt; System: Yêu cầu danh sách hồ sơ\nSystem -&gt; DB: Lấy hồ sơ trạng thái Đã nộp\nDB --&gt; System: Danh sách hồ sơ\nSystem --&gt; UI: 2. Hiển thị danh sách\n\nOfficer -&gt; UI: 3. Chọn hồ sơ cần tiếp nhận\nUI -&gt; System: Yêu cầu thông tin hồ sơ\nSystem -&gt; DB: Lấy thông tin hồ sơ\nDB --&gt; System: Thông tin hồ sơ\nSystem --&gt; UI: 4. Hiển thị thông tin hồ sơ\n\nOfficer -&gt; UI: 5. Xác nhận tiếp nhận\nUI -&gt; System: Gửi xác nhận\n\nSystem -&gt; DB: 6. Cập nhật trạng thái Đang kiểm tra\nDB --&gt; System: Cập nhật thành công\n\nSystem -&gt; DB: 7. Lưu lịch sử xử lý\nDB --&gt; System: Lưu thành công\n\nSystem --&gt; UI: Tiếp nhận thành công\nUI --&gt; Officer: Hiển thị trạng thái mới\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4zk7aWjwRpn0hvaEuwQ2-20">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
