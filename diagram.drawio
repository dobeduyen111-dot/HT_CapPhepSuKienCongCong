        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC08 Kiểm tra tính hợp lệ hồ sơ\n\nactor \&quot;Người xử lý hồ sơ\&quot; as Officer\nboundary \&quot;Giao diện kiểm tra hồ sơ\&quot; as UI\ncontrol \&quot;Hệ thống\&quot; as System\ndatabase \&quot;Cơ sở dữ liệu\&quot; as DB\n\nOfficer -&gt; UI: 1. Mở hồ sơ\nUI -&gt; System: Yêu cầu hồ sơ\nSystem -&gt; DB: Lấy thông tin và tài liệu\nDB --&gt; System: Hồ sơ\nSystem --&gt; UI: 2. Hiển thị thông tin và tài liệu\n\nOfficer -&gt; UI: 3. Kiểm tra tính đầy đủ và hợp lệ\nUI -&gt; System: Gửi kết quả kiểm tra\n\nSystem -&gt; System: 4. Hỗ trợ kiểm tra hồ sơ\n\nalt Hồ sơ hợp lệ\n    Officer -&gt; UI: 5. Xác nhận hồ sơ hợp lệ\n    UI -&gt; System: Gửi xác nhận\n\n    System -&gt; DB: 6. Cập nhật Đang thẩm định\n    DB --&gt; System: Thành công\n\nelse Hồ sơ thiếu hoặc không hợp lệ\n    Officer -&gt; UI: 3.1. Xác định hồ sơ chưa hợp lệ\n    UI -&gt; System: Yêu cầu bổ sung\n\n    System -&gt; DB: 3.2. Cập nhật Yêu cầu bổ sung\n    DB --&gt; System: Thành công\n\n    System -&gt; System: Thực hiện UC26 - Gửi thông báo\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6SYEwyuJK9MHmqEQbmld-29">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
