        <UserObject label="Activity Diagram - UC04 Nộp hồ sơ cấp phép" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram - UC04 Nộp hồ sơ cấp phép" id="qFJpqAqwRVEhF2Vit24c-24">
