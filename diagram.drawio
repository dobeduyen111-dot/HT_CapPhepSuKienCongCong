        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sequence Diagram - UC05 Theo dõi trạng thái hồ sơ\n\nactor \&quot;Người tổ chức sự kiện\&quot; as Organizer\nboundary \&quot;Giao diện theo dõi hồ sơ\&quot; as UI\ncontrol \&quot;Hệ thống\&quot; as System\ndatabase \&quot;Cơ sở dữ liệu\&quot; as DB\n\nOrganizer -&gt; UI: 1. Chọn theo dõi hồ sơ\nUI -&gt; System: Yêu cầu danh sách hồ sơ\nSystem -&gt; DB: Lấy danh sách hồ sơ\nDB --&gt; System: Danh sách hồ sơ\nSystem --&gt; UI: 2. Hiển thị danh sách hồ sơ\nUI --&gt; Organizer: Hiển thị danh sách\n\nOrganizer -&gt; UI: 3. Chọn hồ sơ cần xem\nUI -&gt; System: Yêu cầu thông tin hồ sơ\nSystem -&gt; DB: Tìm hồ sơ\nDB --&gt; System: Kết quả tìm kiếm\n\nalt Hồ sơ không tồn tại\n    System --&gt; UI: 3.2. Thông báo không tìm thấy hồ sơ\n    UI --&gt; Organizer: Hiển thị thông báo\nelse Hồ sơ tồn tại\n    System --&gt; UI: 4. Hiển thị trạng thái và thông tin xử lý\n    UI --&gt; Organizer: Hiển thị thông tin hồ sơ\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="h-QHLptJ9cpGYOP9lwc8-23">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
